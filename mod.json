{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "isotonicbunk.req-indic",
	"name": "REQ Indicator",
	"version": "v1.0.0",
	"developers": ["isotonicbunk"],
	"description": "",
	"tags": ["universal", "offline", "interface", "joke"],
	"links": {
		"source": "https://github.com/IsotonicBunk/REQIndicator"
	},
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"prevter.imageplus": ">=1.1.1"
	},
	"resources": {
		"files": [
    		"resources/*.png",
			"resources/*.webp"
    	]
	},
	"settings": {
		"title-general": {
			"type": "title",
			"name": "General"
		},
		"enabled": {
    		"type": "bool",
    		"name": "Enabled",
    		"description": "Enable REQ indicator",
    		"default": true
		},
		"indic": {
    	"type": "string",
    	"name": "Indicator",
		"description": "Choose indicator state",
    	"default": "Animated REQ=OFF",
    	"one-of": ["Simple REQ=OFF", "Animated REQ=OFF", "HOLY REQ=OFF", "Simple REQ=ON", "Animated REQ=ON"],
		"enable-if": "!is-custom"
		},
		"is-custom": {
    		"type": "bool",
    		"name": "Custom Indicator",
    		"description": "Use custom animation as indicator state",
    		"default": false
		},
		"custom-path": {
    		"type": "file",
    		"name": "Custom Indicator Path",
			"description": "Path to your custom Indicator file. Supports PNG, WEBP (Animated), JPEG and GIF (buggy). Recommended size: 600x200px",
    		"default": {
    		    "win": "{mod_resources_dir}/file-example.png",
    		    "mac": "{mod_resources_dir}/file-example.png",
    		    "android": "{mod_resources_dir}/file-example.png"
    		},
    		"control": {
    		    "dialog": "open",
    		    "filters": [
    		        {
    		            "files": ["*.png", "*.webp", "*.gif", "*.jpeg", "*.jpg"],
    		            "description": "Image or Animation file"
    		        }
    		    ]
    		},
		"enable-if": "is-custom"
		},
		"scale": {
			"type": "float",
			"name": "Scale",
			"description": "Change the size of animation",
			"default": 0.6,
    		"min": 0.5,
    		"max": 2.5,
    		"control": {
    		    "arrows": true,
    		    "arrow-step": 0.05,
    		    "slider": true,
    		    "slider-step": 0.01,
    		    "input": true
    		}
		},
		"title-adv": {
			"type": "title",
			"name": "Advanced"
		},
		"offset-x": {
			"type": "float",
			"name": "X Offset",
			"description": "Change indicator X Pos offset",
			"default": 75,
    		"min": -100,
    		"max": 700,
    		"control": {
    		    "arrows": true,
    		    "arrow-step": 1,
    		    "slider": true,
    		    "slider-step": 1,
    		    "input": true
    		}
		},
		"offset-y": {
			"type": "float",
			"name": "Y Offset",
			"description": "Change indicator Y Pos offset",
			"default": 26,
    		"min": -400,
    		"max": 100,
    		"control": {
    		    "arrows": true,
    		    "arrow-step": 1,
    		    "slider": true,
    		    "slider-step": 1,
    		    "input": true
    		}
		}

	}
}
